# Переменные окружения проекта ЦТТ «Импульс»
#
# Скопируйте в .env.local и заполните. На Vercel — Project → Settings → Environment Variables.
# Секреты не коммитить.

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=vck1yb4o
NEXT_PUBLIC_SANITY_DATASET=production

# --- Заявки формы #booking (Resend) ---
# Обязательно для отправки заявок на email.
RESEND_API_KEY=
# От кого (нужен верифицированный домен в Resend; для теста — onboarding@resend.dev)
BOOKING_FROM_EMAIL=onboarding@resend.dev
# Кому приходят заявки
BOOKING_TO_EMAIL=info@tennis-impuls.ru

# --- YCLIENTS (онлайн-запись), когда будет подключаться ---
# YCLIENTS_API_TOKEN=
# YCLIENTS_COMPANY_ID=
