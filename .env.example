# Переменные окружения проекта ЦТТ «Импульс»
#
# Скопируйте в .env.local и заполните. На Vercel — Project → Settings → Environment Variables.

# --- YCLIENTS (онлайн-запись), когда будет подключаться ---
# YCLIENTS_API_TOKEN=
# YCLIENTS_COMPANY_ID=

# --- Заявки формы #booking ---
# Если оба заданы — заявка уходит в Telegram.
# Если нет — клиент открывает mailto:info@tennis-impuls.ru с текстом заявки.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
