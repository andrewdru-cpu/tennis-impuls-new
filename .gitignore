# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
hero-screenshot*.png
_imglist.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (секреты — НИКОГДА не коммитим)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / IDE
.idea/
.vscode/*
!.vscode/extensions.json

# исходные медиа-материалы (тяжёлые оригиналы)
/media-raw

# тяжёлые / исходные форматы — не деплоить
*.MOV
*.mov
*.heic
*.HEIC

# JPEG-оригиналы после конвертации в WebP (не деплоить лишнее)
public/images/**/*.jpg
public/images/**/*.jpeg
public/images/**/*.JPG
# Исключения: JPEG fallbacks для корп. прокси (WebP блокируется)
!public/images/hero/*.jpg
!public/images/team/*.jpg
!public/images/news/*.jpg
!public/images/gallery/*.jpg
!public/images/kids/*.jpg
!public/images/services/*.jpg
!public/images/services/*.JPG
!public/images/videos/**
# сырые исходники (не для деплоя)
public/images/kids/20230528_115740(0).jpg
public/images/kids/IMG_0003 (5).JPG
public/images/services/IMG_8857.jpg
